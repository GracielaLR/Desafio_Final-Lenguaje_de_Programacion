    <mxGraphModel dx="1664" dy="874" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% Jerarquía de Herencia\n    Persona &lt;|-- Paciente : Herencia\n    Persona &lt;|-- Medico : Herencia\n\n    %% Relaciones Principales\n    Paciente \&quot;1\&quot; -- \&quot;1..*\&quot; CitaMedica : Solicita\n    Medico \&quot;1\&quot; -- \&quot;1..*\&quot; CitaMedica : Atiende\n    CitaMedica \&quot;1\&quot; *-- \&quot;0..1\&quot; AtencionMedica : Genera\n    AtencionMedica \&quot;1\&quot; *-- \&quot;0..*\&quot; DetalleReceta : Contiene\n    DetalleReceta \&quot;*\&quot; --&gt; \&quot;1\&quot; Medicamento : Prescribe\n    AtencionMedica ..&gt; RegistroAtencionBD : Persiste en\n\n    %% Definición de la Clase Base Persona\n    class Persona {\n        -String idPersona\n        -String dni\n        -String nombres\n        -String apellidos\n        -Date fechaNacimiento\n        -String telefono\n        +getNombreCompleto() String\n    }\n\n    %% Definición de Paciente\n    class Paciente {\n        -String numeroHistoriaClinica\n        -String tipoSeguro\n        +solicitarCita() void\n        +consultarHistorial() List\n    }\n\n    %% Definición de Medico\n    class Medico {\n        -String cmp\n        -String especialidad\n        +atenderCita() void\n        +emitirReceta() void\n    }\n\n    %% Definición de CitaMedica\n    class CitaMedica {\n        -String idCita\n        -DateTime fechaHora\n        -EstadoCita estado\n        -String motivoConsulta\n        +programarCita() void\n        +cancelarCita() void\n        +registrarAtencion() AtencionMedica\n    }\n\n    %% Definición de AtencionMedica\n    class AtencionMedica {\n        -String idAtencion\n        -DateTime fechaAtencion\n        -String diagnostico\n        -String tratamiento\n        +agregarDetalleReceta() void\n        +generarInforme() String\n    }\n\n    %% Definición de DetalleReceta\n    class DetalleReceta {\n        -int cantidad\n        -String indicaciones\n        +validarStock() boolean\n    }\n\n    %% Definición de Medicamento\n    class Medicamento {\n        -String idMedicamento\n        -String nombre\n        -int stockDisponible\n        -Date fechaVencimiento\n        +actualizarStock(int cant) void\n        +estaVencido() boolean\n    }\n\n    %% Definición del Repositorio de Datos\n    class RegistroAtencionBD {\n        &lt;&lt;Repository&gt;&gt;\n        -String conexionBD\n        +guardarAtencion(AtencionMedica atencion) boolean\n        +buscarPorPaciente(String dni) List\n        +generarReporteMinsa() File\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2qx2rMG1z1tUM1CRD-Ru-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
